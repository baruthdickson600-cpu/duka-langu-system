{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/send-sms.js": {
      "maxDuration": 30
    },
    "api/send-email.js": {
      "maxDuration": 30
    },
    "api/test-email.js": {
      "maxDuration": 30
    },
    "api/cron/daily-backup.js": {
      "maxDuration": 60
    },
    "api/cron/daily-reports.js": {
      "maxDuration": 60
    },
    "api/cron/subscription-reminders.js": {
      "maxDuration": 60
    },
    "api/sms-balance.js": {
      "maxDuration": 15
    },
    "api/cron/daily-email-report.js": {
      "maxDuration": 300
    },
    "api/cron/staff-email-report.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-backup",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/daily-reports",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/subscription-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily-email-report",
      "schedule": "0 5 * * *"
    }
  ]
}